{
  "version": 8,
  "name": "Bismillah Menang Base",
  "metadata": {
    "attribution": "Batas administrasi: BPS / BIG (akses: 2026-11-26)"
  },
  "sources": {
    "provinces": {
      "type": "geojson",
      "data": "/geo/provinces.geojson",
      "generateId": true
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8fafc"
      }
    },
    {
      "id": "province-fill",
      "type": "fill",
      "source": "provinces",
      "paint": {
        "fill-color": [
          "match",
          ["get", "status"],
          "DILAPORKAN_BELUM_MENERIMA_BANTUAN", "#fff3e0",
          "AKSES_TERISOLIR", "#ffebee",
          "BELUM_TERVERIFIKASI", "#f5f5f5",
          "#e0e0e0"
        ],
        "fill-opacity": 0.7,
        "fill-outline-color": "#9e9e9e"
      }
    },
    {
      "id": "province-boundary",
      "type": "line",
      "source": "provinces",
      "paint": {
        "line-color": "#9e9e9e",
        "line-width": 1.5
      }
    },
    {
      "id": "province-label",
      "type": "symbol",
      "source": "provinces",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Roboto Regular", "Arial Unicode MS Regular"],
        "text-size": 11,
        "text-anchor": "center",
        "text-allow-overlap": true
      },
      "paint": {
        "text-color": "#1a1a1a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}