{
  "version": 8,
  "name": "Transparansi Bencana Base",
  "metadata": {
    "attribution": "Batas administrasi: BPS / BIG (akses: 2026-11-26)"
  },
  "sources": {
    "provinces": {
      "type": "geojson",
      "data": "/geo/provinces.geojson",
      "promoteId": "code"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#e8f1f8"
      }
    },
    {
      "id": "province-coastal-halo",
      "type": "line",
      "source": "provinces",
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#c8dceb",
        "line-width": 5,
        "line-opacity": 0.7
      }
    },
    {
      "id": "province-fill",
      "type": "fill",
      "source": "provinces",
      "paint": {
        "fill-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false], "#94a3b8",
          ["boolean", ["feature-state", "hover"], false], "#d5e3ee",
          [
            "match",
            ["get", "status"],
            "DILAPORKAN_BELUM_MENERIMA_BANTUAN", "#fff3e0",
            "AKSES_TERISOLIR", "#ffebee",
            "BELUM_TERVERIFIKASI", "#e2e8f0",
            "#f8fafc"
          ]
        ],
        "fill-opacity": 0.95
      }
    },
    {
      "id": "province-boundary",
      "type": "line",
      "source": "provinces",
      "paint": {
        "line-color": "#64748b",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3.5, 0.9,
          7, 1.8
        ]
      }
    },
    {
      "id": "province-selected",
      "type": "line",
      "source": "provinces",
      "filter": ["==", ["get", "code"], ""],
      "paint": {
        "line-color": "#0f172a",
        "line-width": 2.4
      }
    }
  ]
}
